# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files that must always have LF line endings
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.lua text eol=lf
*.qml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.desktop text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
